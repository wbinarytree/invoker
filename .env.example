# Invoker environment template. Copy to .env and fill in.

# Required for STRATZ GraphQL access. Phase 1 runs without it (thinner pro coverage).
STRATZ_API_TOKEN=

# Required for Gemini extraction (free tier is fine).
GOOGLE_API_KEY=

# Optional overrides
INVOKER_DATA_DIR=data
INVOKER_LLM_CLIENT=gemini           # gemini | manual | anthropic | openai
INVOKER_LOG_LEVEL=INFO

# LLM model selection (defaults shown; swap to use Gemma quota)
# INVOKER_LLM_MODEL=gemini-2.5-flash  # or: gemma-4-31b-it
# INVOKER_LLM_RPM=5                   # requests per minute ceiling
# INVOKER_LLM_RPD=20                  # requests per day ceiling (gemma-4-31b-it: 100)

# Dev hero filter — restrict bootstrap to a subset of heroes (names or numeric ids).
# Keeps Gemini call count low (free tier: 20/day). Unset for full production bootstrap.
# Example dev set (Pangolier + Slardar):
# INVOKER_DEV_HEROES=Pangolier,Slardar
