    "sentences": [
      {
        "text": "Mage Slayer is a rare item costing 3100 gold.",
        "marks": [
          "gamefile:items/item_mage_slayer#cost"
        ]
      },
      {
        "text": "It combines magic resistance and regeneration with an attack-applied debuff that burns physical damage over time and cripples enemy spell output.",
        "marks": [
          "gamefile:items/item_mage_slayer#cost"
        ]
      },
      {
        "text": "It is built from Perseverance, Cloak, Blades of Attack, and Orb of Venom.",
        "marks": [
          "gamefile:items/item_mage_slayer#components"
        ]
      },
      {
        "text": "It grants 12 damage, 5.5 health regeneration, 18% magic resistance, and 2.5 mana regeneration.",
        "marks": [
          "gamefile:items/item_mage_slayer#attribs"
        ]
      },
      {
        "text": "Attacking an enemy places a debuff on it that deals damage over time and reduces the spell damage that target deals.",
        "marks": [
          "loc:DOTA_Tooltip_ability_item_mage_slayer_Description"
        ]
      },
      {
        "text": "The debuff deals 35 DPS, applies a 40 spell amp debuff, and lasts 3 seconds.",
        "marks": [
          "gamefile:items/item_mage_slayer#attribs"
        ]
      },
      {
        "text": "The ability is passive and flagged not to proc other abilities; its damage is physical and the debuff is dispellable.",
        "marks": [
          "gamefile:items/item_mage_slayer#mechanics"
        ]
      },
      {
        "text": "Lore: it was forged by a secret order in The Third Age of Praxa'cia to fell the False King.",
        "marks": [
          "loc:DOTA_Tooltip_ability_item_mage_slayer_Lore"
        ]
      }
